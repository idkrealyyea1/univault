# =====================================================================
# UniVault — Backend environment variables
# Copy to your Render Web Service -> Environment (or to a local .env file
# when developing). NEVER commit real values.
# =====================================================================

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxx
ADMIN_PASSWORD_HASH=xxxxx              # bcrypt hash of your admin password
JWT_SECRET=xxxxx
ALLOWED_ORIGIN=https://your-site.netlify.app
VAPID_PUBLIC_KEY=xxxxx
VAPID_PRIVATE_KEY=xxxxx
VAPID_SUBJECT=mailto:you@example.com

# PORT is set automatically by Render (defaults to 3000 in server.js)
